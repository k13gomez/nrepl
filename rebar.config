%% BEAM build of nREPL for clojerl. The JVM build uses deps.edn.

{erl_opts, [debug_info]}.

%% The library user supplies clojerl, so it is only a profile dependency.
{deps, []}.

{plugins, [{rebar3_clojerl, "0.8.8"}]}.

{clje_src_dirs, ["src/clje", "src/clojure"]}.
{clje_test_dirs, ["test/clje", "test/clojure"]}.

{ clje_exclude
, [ %% JVM only. These namespaces have no BEAM version.
    "nrepl/socket/jdk17.cljc"
  , "nrepl/socket/junixsocket.cljc"
  , "nrepl/util/classloader.cljc"
  , "nrepl/util/jvmti.cljc"

    %% Not ported yet. Each milestone removes its files from this list.
  , "nrepl/cmdline.cljc"
  , "nrepl/tls_client_proxy.cljc"
  ]
}.

{ profiles
, [ {test, [{deps, [{clojerl, "0.9.1"}]}]}
  , {ci, [{deps, [{clojerl, "0.9.1"}]}]}
  ]
}.

%% clojerl depends on test_check, and test_check declares clojerl as a
%% dependency. clojerl breaks the cycle with this same override.
{overrides, [{override, test_check, [{deps, []}]}]}.
