(ns nrepl.beam.bytes
  "Byte streams for the BEAM. They take the place of the JVM
  `PushbackInputStream` and `OutputStream` that `nrepl.bencode` uses.

  A binary input keeps its buffer in a process-val. Only the process
  that made the input can read from it.")

(defprotocol ByteInput
  "A source of bytes with a pushback buffer."
  (read-byte [input]
    "Return the next byte as an integer from 0 to 255.
  Return -1 at the end of the input.")
  (read-bytes [input n]
    "Return a binary with the next `n` bytes.
  The binary is shorter than `n` bytes at the end of the input.")
  (unread [input b]
    "Push the byte `b` back, so that the next read returns it first."))

(defprotocol ByteOutput
  "A sink of bytes."
  (write [output data]
    "Write `data` to `output`. The data is a binary, a string or an
  iolist. Return `output`."))

(deftype BinaryInput [buf]
  ByteInput
  (read-byte [_]
    (let [b @buf]
      (if (zero? (erlang/byte_size b))
        -1
        (do (vreset! buf (erlang/binary_part b 1 (dec (erlang/byte_size b))))
            (binary/at b 0)))))
  (read-bytes [_ n]
    (let [b @buf
          size (erlang/byte_size b)
          n (min n size)]
      (vreset! buf (erlang/binary_part b n (- size n)))
      (erlang/binary_part b 0 n)))
  (unread [_ b]
    (vreset! buf (erlang/iolist_to_binary #erl(b @buf))))

  clojerl.IStringable
  (str [_] "#<nrepl.beam.bytes.BinaryInput>"))

(deftype BinaryOutput [acc]
  ByteOutput
  (write [this data]
    (vreset! acc #erl(@acc data))
    this)

  clojerl.IStringable
  (str [_] "#<nrepl.beam.bytes.BinaryOutput>"))

(defn- utf8-length
  "Return the byte length of the UTF-8 character that starts with byte `b`.
  An invalid lead byte counts as one byte."
  [b]
  (cond
    (< b 16r80) 1
    (= (bit-and b 16rE0) 16rC0) 2
    (= (bit-and b 16rF0) 16rE0) 3
    (= (bit-and b 16rF8) 16rF0) 4
    :else 1))

(defn- read-char
  "Return the next UTF-8 character of the byte input `input` as a binary,
  or :eof at the end of the input."
  [input]
  (let [b (read-byte input)]
    (if (neg? b)
      :eof
      (let [n (utf8-length b)]
        (erlang/iolist_to_binary
         #erl(b (if (> n 1) (read-bytes input (dec n)) "")))))))

(deftype CharReader [input]
  erlang.io.IReader
  (read [_]
    (read-char input))
  (read [_ n]
    (loop [acc []
           n n]
      (let [ch (if (pos? n) (read-char input) :eof)]
        (if (= :eof ch)
          (if (seq acc) (erlang/iolist_to_binary (clj_rt/to_list acc)) :eof)
          (recur (conj acc ch) (dec n))))))
  (read_line [_]
    (loop [acc []]
      (let [ch (read-char input)]
        (cond
          (and (= :eof ch) (empty? acc)) :eof
          (or (= :eof ch) (= "\n" ch)) (erlang/iolist_to_binary (clj_rt/to_list acc))
          :else (recur (conj acc ch))))))
  (skip [this n]
    (let [s (.read this n)]
      (if (= :eof s) 0 (count s))))

  erlang.io.IPushbackReader
  (unread [_ s]
    ;; Push the bytes back last to first, so that the first byte reads first.
    (doseq [b (reverse (erlang/binary_to_list s))]
      (unread input b)))

  clojerl.IStringable
  (str [_] "#<nrepl.beam.bytes.CharReader>"))

(defn char-reader
  "Return a reader of UTF-8 characters over the byte input `input`. The
  clojerl reader and `clojure.edn/read` can read from it."
  [input]
  (CharReader. input))

(defn binary-input
  "Return a byte input that reads the binary `b`."
  [b]
  (BinaryInput. (process-val! b)))

(defn binary-output
  "Return a byte output that collects what it gets in memory.
  Call `output->binary` to get the bytes."
  []
  (BinaryOutput. (process-val! #erl())))

(defn output->binary
  "Return the bytes that `output` collected, as one binary."
  [^BinaryOutput output]
  (erlang/iolist_to_binary @(.-acc output)))
